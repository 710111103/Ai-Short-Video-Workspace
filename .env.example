# Copy this file to data/config/.env, or fill the same values in the app's 配置 page.
# Never commit data/config/.env.

# Text generation
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_TYPE=enabled
DEEPSEEK_REASONING_EFFORT=high
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=90

# Search / references
TAVILY_API_KEY=
TAVILY_TOPIC=general
TAVILY_MAX_REFERENCES=20

# Grok web research through local chenyme/grok2api.
# Create a client key in Grok2API, then paste it here or on the app's config page.
GROK2API_BASE_URL=http://127.0.0.1:8000
GROK2API_API_KEY=
GROK2API_MODEL=grok-chat-fast
GROK2API_TIMEOUT_SECONDS=120

# Image generation
IMAGE_PROVIDER=auto
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_VIDEO_MODEL=doubao-seedance-2-0-260128
VIDEO_PROVIDER=off
VIDEO_MOTION_MODE=key_scenes
VIDEO_CLIP_COUNT=2
VIDEO_CLIP_DURATION_SECONDS=5
VIDEO_CLIP_RESOLUTION=720p
VIDEO_CLIP_TIMEOUT_SECONDS=1200
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_IMAGE_MODEL=agnes-image-2.1-flash
AGNES_VIDEO_MODEL=agnes-video-v2.0
ARK_IMAGE_WEB_SEARCH_COVER=false
ARK_IMAGE_WEB_SEARCH_SCENE=false

# GPT Image Playground web automation.
# Set IMAGE_PROVIDER=imageai_playground to use https://imageai.centos.hk/.
# When IMAGEAI_PLAYGROUND_USE_SAVED_SETTINGS=true, configure API key/model once inside the website;
# the app will only type prompts, click generate, save the result, then clear task/image history.
IMAGEAI_PLAYGROUND_URL=https://imageai.centos.hk/
IMAGEAI_PLAYGROUND_USE_SAVED_SETTINGS=true
IMAGEAI_PLAYGROUND_DELETE_AFTER_SAVE=true
IMAGEAI_PLAYGROUND_USER_DATA_DIR=
IMAGEAI_PLAYGROUND_HEADLESS=false
IMAGEAI_PLAYGROUND_WAIT_SECONDS=900

APIYI_API_KEY=
APIYI_BASE_URL=https://api.apiyi.com
APIYI_IMAGE_MODEL=gpt-image-2-all
APIYI_IMAGE_REPLACE_ARK=false
THIRD_PARTY_IMAGE_API_KEY=
# NewAPI example: https://your-newapi-host or https://your-newapi-host/v1
THIRD_PARTY_IMAGE_BASE_URL=
# NewAPI model examples: gpt-image-1, dall-e-3, gpt-image-2-all
THIRD_PARTY_IMAGE_MODEL=gpt-image-1
THIRD_PARTY_IMAGE_TIMEOUT_SECONDS=480
THIRD_PARTY_IMAGE_RETRIES=3

# ChatGPT image entry values:
# chatgpt_web_auto = fully automated website flow
# chatgpt_web_handoff = manual website handoff only
# chatgpt_desktop_handoff = ChatGPT Classic desktop handoff only
# CHATGPT_IMAGE_OPEN_TARGET is retained only for legacy chatgpt_handoff configs.
CHATGPT_IMAGE_OPEN_TARGET=web
CHATGPT_IMAGE_WEB_URL=https://chatgpt.com/
CHATGPT_IMAGE_DESKTOP_PATH=chatgpt://
CHATGPT_IMAGE_AUTO_OPEN=true
CHATGPT_IMAGE_DELETE_AFTER_SAVE=true
CHATGPT_IMAGE_CLOSE_BROWSER_AFTER_SAVE=true
CHATGPT_IMAGE_WAIT_SECONDS=900
# 页面没有生图活动、内容变化或新图片时，提前停止空等（秒）。
CHATGPT_IMAGE_STALL_SECONDS=240
CHATGPT_IMAGE_ACTIVE_LIMIT_SECONDS=420
# 多账号端口池：账号 1 使用 9222，账号 2 使用 9223，以此类推。
CHATGPT_IMAGE_ACCOUNT_COUNT=1
CHATGPT_IMAGE_ACCOUNT_LABELS=
CHATGPT_IMAGE_CDP_BASE_PORT=9222
CHATGPT_IMAGE_ACCOUNT_COOLDOWN_SECONDS=180
CHATGPT_IMAGE_QUOTA_COOLDOWN_SECONDS=18000
CHATGPT_IMAGE_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHATGPT_IMAGE_USER_DATA_DIR=
# 后台端口模式仍使用普通 Chrome，只把窗口移到屏幕外，避免 Cloudflare 拦截。
CHATGPT_IMAGE_HEADLESS=false
# 仅用于诊断；真无头模式可能触发 ChatGPT 安全验证，不建议开启。
CHATGPT_IMAGE_TRUE_HEADLESS=false

# Volcengine TTS / ASR
VOLC_TTS_APP_KEY=
VOLC_TTS_ACCESS_KEY=
VOLC_TTS_RESOURCE_ID=volc.service_type.10050
VOLC_TTS_SPEAKER_1=zh_male_dayixiansheng_v2_saturn_bigtts
VOLC_TTS_SPEAKER_2=zh_female_mizaitongxue_v2_saturn_bigtts
VOLC_TTS_RANDOM_ORDER=true
VOLC_TTS_ACTION=0
VOLC_TTS_SPEECH_RATE=1.0

VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
VOLC_ASR_MODE=submit
VOLC_ASR_RESOURCE_ID=volc.seedasr.auc

# social-auto-upload integration
SAU_REPO_PATH=
SAU_UV_BIN=uv
SAU_BROWSER_MODE=headless
SAU_PATCHRIGHT_DOWNLOAD_HOST=
SAU_XHS_CREATOR_BASE_URL=https://creator.xiaohongshu.com

# App defaults
DEFAULT_TEMPLATE=单人讲故事
BGM_VOLUME=0.09
BGM_AUTO_MODE=auto
BGM_ONLINE_PROVIDER=loudly
LOUDLY_API_KEY=
JAMENDO_CLIENT_ID=
FREESOUND_API_KEY=
BGM_DOWNLOAD_URL=
# 在线 BGM 下载后用 ASR 检查可辨人声；auto 会在已有火山 TTS/ASR 密钥时启用。
BGM_VOCAL_AUDIT=auto
BGM_VOCAL_AUDIT_MAX_CANDIDATES=5
BGM_VOCAL_AUDIT_TIMEOUT_SECONDS=240

# 文案改稿专用：短思考、直接输出最终稿
DEEPSEEK_REWRITE_THINKING_TYPE=disabled
DEEPSEEK_REWRITE_REASONING_EFFORT=low
